// Icône et informations de version de JSG Guitar.exe
#include <winver.h>

1 ICON "jsg.ico"

1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040C04B0"
        BEGIN
            VALUE "CompanyName",      "JSG\0"
            VALUE "FileDescription",  "JSG Guitar\0"
            VALUE "FileVersion",      "0.1.0\0"
            VALUE "ProductName",      "JSG Guitar\0"
            VALUE "ProductVersion",   "0.1.0 (prototype sans JUCE)\0"
            VALUE "OriginalFilename", "JSG Guitar.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040C, 1200
    END
END
1 24 "jsg.manifest"
