            VALUE "CompanyName",      "JSG\0"
            VALUE "FileDescription",  "JSG Guitar\0"
            VALUE "FileVersion",      "0.1.0\0"
            VALUE "ProductName",      "JSG Guitar\0"
            VALUE "ProductVersion",   "0.1.0\0"
            VALUE "LegalCopyright",   "(C) 2026 Jérôme Soler - GPL v3\0"
            VALUE "OriginalFilename", "JSG Guitar.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
